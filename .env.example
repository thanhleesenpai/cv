# Copy this file to .env.local for local testing (never commit the real .env.local).
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Shared password for the /admin.html editor. Pick something long and random.
ADMIN_PASSWORD=

# GitHub Personal Access Token (fine-grained, scoped to just this repo,
# permission: Contents = Read and write). Used by api/save-cv.js to commit
# edits back to the repository.
GITHUB_TOKEN=

# Optional overrides - defaults already match this repo.
# GITHUB_OWNER=thanhleesenpai
# GITHUB_REPO=cv
# GITHUB_BRANCH=main
# GITHUB_FILE_PATH=data.json
